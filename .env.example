# ==== Gemini (LLM + Embedding) — https://aistudio.google.com/apikey ====
GEMINI_API_KEY=your_gemini_key_here
# gemini-2.5-flash bi 404 'no longer available to new users' -> dung ban flash moi hon
GEMINI_CHAT_MODEL=gemini-3.6-flash
# Model nhe cho classify/rewrite - quota free tier tinh rieng tung model
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=1536

# ==== Qdrant Cloud Free — https://cloud.qdrant.io ====
QDRANT_URL=https://xxxxxxxx.xxxxx.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_key_here
QDRANT_COLLECTION=vna_annual_report_2024

# ==== Cohere Rerank — https://dashboard.cohere.com/api-keys ====
COHERE_API_KEY=your_cohere_key_here
COHERE_RERANK_MODEL=rerank-v3.5

# ==== Source document ====
SOURCE_PDF=../RAG-test/2024.pdf
SOURCE_NAME=Bao cao thuong nien 2024 - Vietnam Airlines.pdf

# ==== Retrieval tuning ====
RETRIEVE_TOP_K=20
RERANK_TOP_N=5
RERANK_MIN_SCORE=0.05
